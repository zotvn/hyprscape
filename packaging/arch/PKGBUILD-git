# Maintainer: cybergaz <kkanttechy@gmail.com>
#
# Same ABI caveat as the release package: rebuild whenever `hyprland` is upgraded.
# Rename this file to PKGBUILD to use it.

pkgname=hyprscape-git
pkgver=0.2.0.r0.g0000000
pkgrel=1
pkgdesc="A niri-style zoom-out overview for Hyprland's scrolling layout (git)"
arch=('x86_64' 'aarch64')
url="https://github.com/cybergaz/hyprscape"
license=('BSD-3-Clause')
depends=('hyprland')
makedepends=('git' 'gcc' 'pkgconf' 'make')
provides=('hyprscape')
conflicts=('hyprscape')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/hyprscape"
  git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' \
    || printf "0.0.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/hyprscape"
  make all
}

package() {
  cd "$srcdir/hyprscape"
  install -Dm755 libhyprscape.so "$pkgdir/usr/lib/libhyprscape.so"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
